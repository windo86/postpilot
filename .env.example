# PostPilot — contoh environment variables (TANPA secret).
# Copy ke .env.local lalu isi nilai asli. Jangan commit .env.local.
# Lihat 2-TECH-SPEC.md §17 untuk daftar lengkap.

# --- Supabase (public, aman untuk browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase service-role (SERVER/WORKER ONLY, jangan pakai prefix NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption (server/worker only, 32 bytes hex) ---
APP_ENCRYPTION_KEY=

# --- Instagram OAuth ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

# --- TikTok OAuth ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# --- Media ---
MEDIA_BUCKET=media

# --- Worker ---
WORKER_POLL_INTERVAL_MS=5000

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=

# --- AI models (configurable, jangan hardcode di kode) ---
OPENAI_MODEL_TEXT=
OPENAI_MODEL_IMAGE=
GOOGLE_MODEL_TEXT=
GOOGLE_MODEL_VIDEO=
